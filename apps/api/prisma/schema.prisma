  purchaseId       String    @unique @map("purchase_id") @db.Uuid
  grantedAt        DateTime  @map("granted_at")
  revokedAt        DateTime? @map("revoked_at")
  revocationReason String?   @map("revocation_reason")

  resource Resource         @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchase ResourcePurchase @relation(fields: [purchaseId], references: [id], onDelete: Restrict)

  @@unique([resourceId, userId])
  @@map("resource_entitlements")
}

model StripeEvent {
  id                 String    @id @default(uuid()) @db.Uuid
  stripeEventId      String    @unique @map("stripe_event_id")
  eventType          String    @map("event_type")
  apiVersion         String?   @map("api_version")
  objectId           String?   @map("object_id")
  livemode           Boolean   @default(false)
  payload            Json
  providerCreatedAt  DateTime  @map("provider_created_at")
  receivedAt         DateTime  @default(now()) @map("received_at")
  processedAt        DateTime? @map("processed_at")
  processingAttempts Int       @default(0) @map("processing_attempts")
  lastErrorCode      String?   @map("last_error_code")

  @@index([processedAt, receivedAt])
  @@map("stripe_events")
}

model BlogPost {
  id              String     @id @default(uuid()) @db.Uuid
  slug            String     @unique
  title           String
  excerpt         String
  bodyRich        Json       @map("body_rich")
  bodyPlain       String     @map("body_plain")
  heroMediaId     String?    @map("hero_media_id") @db.Uuid
  status          BlogStatus @default(DRAFT)
  publishedAt     DateTime?  @map("published_at")
  scheduledAt     DateTime?  @map("scheduled_at")
  createdByUserId String?    @map("created_by_user_id") @db.Uuid
  updatedByUserId String?    @map("updated_by_user_id") @db.Uuid
  version         Int        @default(1)
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  heroMedia  MediaAsset?        @relation(fields: [heroMediaId], references: [id], onDelete: SetNull)
  createdBy  User?              @relation("BlogPostCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy  User?              @relation("BlogPostUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  categories BlogPostCategory[]
  tags       BlogPostTag[]

  @@index([status, publishedAt(sort: Desc)])
  @@map("blog_posts")
}

model BlogCategory {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  name        String   @unique
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  posts BlogPostCategory[]

  @@map("blog_categories")
}

model BlogTag {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  posts BlogPostTag[]

  @@map("blog_tags")
}

model BlogPostCategory {
  blogPostId String @map("blog_post_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  post     BlogPost     @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  category BlogCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([blogPostId, categoryId])
  @@index([categoryId, blogPostId])
  @@map("blog_post_categories")
}

model BlogPostTag {
  blogPostId String @map("blog_post_id") @db.Uuid
  tagId      String @map("tag_id") @db.Uuid

  post BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  tag  BlogTag  @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@id([blogPostId, tagId])
  @@index([tagId, blogPostId])
  @@map("blog_post_tags")
}

model AnalyticsEventDefinition {
  key               String   @id
  version           Int
  description       String
  allowedProperties Json     @map("allowed_properties")
  active            Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  events AnalyticsEvent[]

  @@map("analytics_event_definitions")
}

model AnalyticsEventDedup {
  id              String   @id @default(uuid()) @db.Uuid
  firstOccurredAt DateTime @map("first_occurred_at")
  receivedAt      DateTime @default(now()) @map("received_at")

  @@map("analytics_event_dedup")
}

model AnalyticsEvent {
  id              String   @id @default(uuid()) @db.Uuid
  occurredAt      DateTime @map("occurred_at")
  receivedAt      DateTime @default(now()) @map("received_at")
  eventKey        String   @map("event_key")
  eventVersion    Int      @map("event_version")
  userId          String?  @map("user_id") @db.Uuid
  anonymousIdHash Bytes?   @map("anonymous_id_hash")
  sessionIdHash   Bytes?   @map("session_id_hash")
  properties      Json     @default("{}")
  source          String
  requestId       String?  @map("request_id")

  definition AnalyticsEventDefinition @relation(fields: [eventKey], references: [key], onDelete: Restrict)
  user       User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventKey, occurredAt])
  @@index([userId, occurredAt])
  @@map("analytics_events")
}

model AnalyticsDailyAggregate {
  metricDate      DateTime @map("metric_date") @db.Date
  metricKey       String   @map("metric_key")
  dimensionKey    String   @default("all") @map("dimension_key")
  dimensionValue  String   @default("all") @map("dimension_value")
  valueNumeric    Decimal  @map("value_numeric") @db.Decimal(20, 4)
  computedAt      DateTime @default(now()) @map("computed_at")
  sourceWindowEnd DateTime @map("source_window_end")

  @@id([metricDate, metricKey, dimensionKey, dimensionValue])
  @@map("analytics_daily_aggregates")
}

model AnalyticsExport {
  id                String                @id @default(uuid()) @db.Uuid
  requestedByUserId String?               @map("requested_by_user_id") @db.Uuid
  reportType        String                @map("report_type")
  filters           Json
  status            AnalyticsExportStatus @default(PENDING)
  objectKey         String?               @unique @map("object_key")
  expiresAt         DateTime?             @map("expires_at")
  completedAt       DateTime?             @map("completed_at")
  idempotencyKey    String                @map("idempotency_key")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  requestedBy User? @relation(fields: [requestedByUserId], references: [id], onDelete: SetNull)

  @@unique([requestedByUserId, idempotencyKey])
  @@map("analytics_exports")
}

model MigrationRun {
  id              String             @id @default(uuid()) @db.Uuid
  sourceSystem    String             @map("source_system")
  dryRun          Boolean            @default(false) @map("dry_run")
  status          MigrationRunStatus @default(RUNNING)
  counts          Json               @default("{}")
  errorCode       String?            @map("error_code")
  startedByUserId String?            @map("started_by_user_id") @db.Uuid
  startedAt       DateTime           @default(now()) @map("started_at")
  completedAt     DateTime?          @map("completed_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  startedBy User?                @relation("MigrationRunStarter", fields: [startedByUserId], references: [id], onDelete: SetNull)
  maps      MigrationSourceMap[]

  @@index([status, startedAt])
  @@map("migration_runs")
}

model MigrationSourceMap {
  id           String               @id @default(uuid()) @db.Uuid
  runId        String?              @map("run_id") @db.Uuid
  entityType   MigrationEntityType  @map("entity_type")
  sourceSystem String               @map("source_system")
  sourceId     String               @map("source_id")
  targetId     String?              @map("target_id") @db.Uuid
  checksum     String?
  status       MigrationMapStatus   @default(PENDING)
  errorCode    String?              @map("error_code")
  metadata     Json?
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  run MigrationRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@unique([sourceSystem, entityType, sourceId])
  @@index([entityType, status])
  @@index([runId])
  @@map("migration_source_maps")
}

model LegacyRedirect {
  id         String   @id @default(uuid()) @db.Uuid
  sourcePath String   @unique @map("source_path")
  targetPath String   @map("target_path")
  statusCode Int      @default(301) @map("status_code")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("legacy_redirects")
}

model AdminRole {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique
  displayName String @map("display_name")

  permissions  AdminRolePermission[]
  userRoles    AdminUserRole[]

  @@map("admin_roles")
}

model AdminRolePermission {
  roleId     String @map("role_id") @db.Uuid
  permission String

  role AdminRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
  @@map("admin_role_permissions")
}

model AdminUserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  grantedAt DateTime @default(now()) @map("granted_at")

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role AdminRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("admin_user_roles")
}

model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  aggregateType String       @map("aggregate_type")
  aggregateId   String       @map("aggregate_id") @db.Uuid
  eventType     String       @map("event_type")
  eventVersion  Int          @default(1) @map("event_version")
  payload       Json
  status        OutboxStatus @default(PENDING)
  availableAt   DateTime     @default(now()) @map("available_at")
  attemptCount  Int          @default(0) @map("attempt_count")
  lockedAt      DateTime?    @map("locked_at")
  lockedBy      String?      @map("locked_by")
  deliveredAt   DateTime?    @map("delivered_at")
  lastErrorCode String?      @map("last_error_code")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  consumptions OutboxConsumption[]

  @@index([status, availableAt, id])
  @@map("outbox_events")
}

model OutboxConsumption {
  consumer    String
  eventId     String   @map("event_id") @db.Uuid
  processedAt DateTime @map("processed_at")
  result      String

  event OutboxEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([consumer, eventId])
  @@map("outbox_consumptions")
}
