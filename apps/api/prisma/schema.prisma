generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  BANNED
  DELETION_PENDING
  ANONYMIZED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DELIVERED
  DEAD
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum MediaPurpose {
  AVATAR
  PROFILE_COVER
  POST_IMAGE
  BLOG_IMAGE
  RESOURCE_MEDIA
}

enum MediaStatus {
  PENDING
  READY
  FAILED
  DELETED
}

enum AccountExportStatus {
  QUEUED
  PROCESSING
  READY
  FAILED
  EXPIRED
}

enum ActivityType {
  PROFILE_UPDATED
  CONNECTION_ACCEPTED
  POST_CREATED
}

enum PostVisibility {
  PUBLIC
  MEMBERS
  CONNECTIONS
  ONLY_ME
}

enum ContentStatus {
  ACTIVE
  DELETED
}

enum ReactionKind {
  SUPPORT
  HUG
  INSIGHTFUL
}

enum IdentityProvider {
  GOOGLE
  APPLE
}

enum TokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
  CHANGE_EMAIL
}

enum CircleVisibility {
  PUBLIC
  PRIVATE
  HIDDEN
}

enum CircleJoinPolicy {
  OPEN
  APPROVAL
  PRIVATE
}

enum CircleRole {
  MEMBER
  ADMIN
}

enum MembershipStatus {
  PENDING
  ACTIVE
  DECLINED
  LEFT
  REMOVED
}

enum CircleStatus {
  PENDING
  ACTIVE
  ARCHIVED
}

enum MessageStatus {
  ACTIVE
  DELETED
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum RsvpStatus {
  GOING
  MAYBE
  NOT_GOING
}

enum EventReminderKind {
  HOURS_24
  HOURS_1
}

enum AiRole {
  USER
  ASSISTANT
}

enum AiConsentType {
  AI_USE
  PERSONALIZATION
  CIRCLE_RECOMMENDATIONS
}

enum AiFlagStatus {
  OPEN
  REVIEWED
  DISMISSED
  ACTIONED
}

enum ResourceKind {
  ARTICLE
  VIDEO
  WORKSHEET
}

enum ResourceAccess {
  PUBLIC_FREE
  MEMBER
  PAID_ONCE
}

enum DonationFrequency {
  ONE_TIME
  MONTHLY
}

enum DonationStatus {
  PENDING
  SUCCEEDED
  ACTIVE
  PAST_DUE
  CANCELLED
  FAILED
  REFUNDED
}

enum PurchaseStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum BlogStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum AnalyticsExportStatus {
  PENDING
  PROCESSING
  READY
  FAILED
  EXPIRED
}

enum MigrationEntityType {
  USER
  CIRCLE
  POST
  COMMENT
  BLOG_POST
  MEDIA
}

enum MigrationMapStatus {
  PENDING
  IMPORTED
  SKIPPED
  FAILED
}

enum MigrationRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

model User {
  id                            String     @id @default(uuid()) @db.Uuid
  email                         String     @unique
  status                        UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt               DateTime?  @map("email_verified_at")
  activatedAt                   DateTime?  @map("activated_at")
  ageAttestedAt                 DateTime?  @map("age_attested_at")
  termsVersion                  String     @map("terms_version")
  privacyVersion                String     @map("privacy_version")
  communityGuidelinesVersion    String     @map("community_guidelines_version")
  termsAcceptedAt               DateTime   @map("terms_accepted_at")
  privacyAcceptedAt             DateTime   @map("privacy_accepted_at")
  communityGuidelinesAcceptedAt DateTime   @map("community_guidelines_accepted_at")
  locale                        String?
  timeZone                      String?    @map("time_zone")
  lastLoginAt                   DateTime?  @map("last_login_at")
  deletionRequestedAt           DateTime?  @map("deletion_requested_at")
  deletionDueAt                 DateTime?  @map("deletion_due_at")
  deletedAt                     DateTime?  @map("deleted_at")
  anonymizedReference           String     @unique @default(uuid()) @map("anonymized_reference") @db.Uuid
  version                       Int        @default(1)
  createdAt                     DateTime   @default(now()) @map("created_at")
  updatedAt                     DateTime   @updatedAt @map("updated_at")

  profile         Profile?
  credential      Credential?
  identities      UserIdentity[]
  emailTokens     EmailToken[]
  sessionFamilies SessionFamily[]
  adminUserRoles  AdminUserRole[]
  mediaAssets     MediaAsset[]
  requestedConnections Connection[] @relation("ConnectionRequester")
  receivedConnections  Connection[] @relation("ConnectionAddressee")
  blocksInitiated UserBlock[] @relation("Blocker")
  blocksReceived  UserBlock[] @relation("Blocked")
  accountExports  AccountExport[]
  activityEvents  ActivityEvent[]
  posts           Post[]
  comments        Comment[]
  postReactions   PostReaction[]
  commentReactions CommentReaction[]
  anonymousUsageDaily AnonymousUsageDaily[]
  postAnonymousAuthors PostAnonymousAuthor[]
  commentAnonymousAuthors CommentAnonymousAuthor[]
  auditLogsAsActor AuditLog[] @relation("AuditActor")
  circlesCreated   Circle[] @relation("CircleCreator")
  circleMemberships CircleMember[]
  circleInvitesSent CircleInvite[] @relation("CircleInviter")
  circleInvitesReceived CircleInvite[] @relation("CircleInvitee")
  circleInvitesAccepted CircleInvite[] @relation("CircleInviteAcceptedBy")
  circleMembershipsInvited CircleMember[] @relation("MemberInvitedBy")
  circleMembershipsDecided CircleMember[] @relation("MemberDecidedBy")
  circleMutesReceived CircleMute[] @relation("CircleMutedUser")
  circleMutesApplied CircleMute[] @relation("CircleMutedBy")
  conversationParticipants ConversationParticipant[]
  messagesSent Message[]
  messageReactions MessageReaction[]
  notificationsReceived Notification[] @relation("NotificationRecipient")
  notificationsActed Notification[] @relation("NotificationActor")
  notificationsTargeted Notification[] @relation("NotificationTarget")
  emailDeliveries EmailDelivery[]
  broadcastsCreated AdminBroadcast[]
  broadcastRecipients BroadcastRecipient[]
  wellnessCheckins WellnessCheckin[]
  eventsCreated Event[] @relation("EventCreator")
  eventRsvps EventRsvp[]
  eventReminders EventReminder[]
  aiConsents AiConsent[]
  aiPreferences AiPreference[]
  aiConversations AiConversation[]
  aiUsageDaily AiUsageDaily[]
  aiModFlagsReviewed AiModFlag[] @relation("AiFlagReviewer")
  resourceProgress ResourceProgress[]
  resourcesCreated Resource[] @relation("ResourceCreator")
  resourcesUpdated Resource[] @relation("ResourceUpdater")
  donations Donation[]
  resourcePurchases ResourcePurchase[]
  resourceEntitlements ResourceEntitlement[]
  blogPostsCreated BlogPost[] @relation("BlogPostCreator")
  blogPostsUpdated BlogPost[] @relation("BlogPostUpdater")
  analyticsExports AnalyticsExport[]
  analyticsEvents AnalyticsEvent[]
  migrationRunsStarted MigrationRun[] @relation("MigrationRunStarter")

  @@index([status, createdAt])
  @@map("users")
}

model Credential {
  userId            String    @id @map("user_id") @db.Uuid
  passwordHash      String    @map("password_hash")
  passwordChangedAt DateTime  @map("password_changed_at")
  failedAttempts    Int       @default(0) @map("failed_attempts")
  lockedUntil       DateTime? @map("locked_until")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("credentials")
}

model UserIdentity {
  id                    String           @id @default(uuid()) @db.Uuid
  userId                String           @map("user_id") @db.Uuid
  provider              IdentityProvider
  providerSubject       String           @map("provider_subject")
  providerEmail         String?          @map("provider_email")
  providerEmailVerified Boolean          @default(false) @map("provider_email_verified")
  linkedAt              DateTime         @map("linked_at")
  lastUsedAt            DateTime         @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@unique([userId, provider])
  @@index([userId])
  @@map("user_identities")
}

model EmailToken {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @map("user_id") @db.Uuid
  purpose      TokenPurpose
  tokenHash    Bytes        @map("token_hash")
  targetEmail  String?      @map("target_email")
  expiresAt    DateTime     @map("expires_at")
  consumedAt   DateTime?    @map("consumed_at")
  attemptCount Int          @default(0) @map("attempt_count")
  createdAt    DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tokenHash])
  @@index([userId, purpose, createdAt])
  @@index([expiresAt])
  @@map("email_tokens")
}

model OAuthTransaction {
  id           String           @id @default(uuid()) @db.Uuid
  provider     IdentityProvider
  stateHash    Bytes            @map("state_hash")
  codeVerifier String?          @map("code_verifier")
  nonce        String?
  returnTo     String?          @map("return_to")
  expiresAt    DateTime         @map("expires_at")
  consumedAt   DateTime?        @map("consumed_at")
  createdAt    DateTime         @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("oauth_transactions")
}

model Profile {
  userId      String   @id @map("user_id") @db.Uuid
  username    String   @unique
  displayName String   @map("display_name")
  bio         String?
  avatarMediaId String? @map("avatar_media_id") @db.Uuid
  coverMediaId  String? @map("cover_media_id") @db.Uuid
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatarMedia MediaAsset? @relation("ProfileAvatar", fields: [avatarMediaId], references: [id], onDelete: SetNull)
  coverMedia  MediaAsset? @relation("ProfileCover", fields: [coverMediaId], references: [id], onDelete: SetNull)

  @@map("profiles")
}

model MediaAsset {
  id               String       @id @default(uuid()) @db.Uuid
  ownerUserId      String?      @map("owner_user_id") @db.Uuid
  purpose          MediaPurpose
  status           MediaStatus  @default(PENDING)
  objectKey        String       @unique @map("object_key")
  originalFilename String?      @map("original_filename")
  declaredMime     String?      @map("declared_mime")
  detectedMime     String?      @map("detected_mime")
  byteSize         BigInt?      @map("byte_size")
  width            Int?
  height           Int?
  verifiedAt       DateTime?    @map("verified_at")
  deletedAt        DateTime?    @map("deleted_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  owner         User?     @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  avatarProfiles Profile[] @relation("ProfileAvatar")
  coverProfiles  Profile[] @relation("ProfileCover")
  postMedia      PostMedia[]
  circleAvatars  Circle[]  @relation("CircleAvatar")
  resources      Resource[]
  blogHeroPosts  BlogPost[]

  @@index([ownerUserId, createdAt])
  @@index([status, createdAt])
  @@map("media_assets")
}

model Connection {
  id          String           @id @default(uuid()) @db.Uuid
  requesterId String           @map("requester_id") @db.Uuid
  addresseeId String           @map("addressee_id") @db.Uuid
  status      ConnectionStatus
  respondedAt DateTime?        @map("responded_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  requester User @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("ConnectionAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status, createdAt])
  @@index([requesterId, status])
  @@map("connections")
}

model UserBlock {
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId, blockerId])
  @@map("user_blocks")
}

model AccountExport {
  id             String               @id @default(uuid()) @db.Uuid
  userId         String               @map("user_id") @db.Uuid
  status         AccountExportStatus
  objectKey      String?              @unique @map("object_key")
  requestedAt    DateTime             @default(now()) @map("requested_at")
  completedAt    DateTime?            @map("completed_at")
  expiresAt      DateTime?            @map("expires_at")
  errorCode      String?              @map("error_code")
  idempotencyKey String?              @map("idempotency_key")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([userId, requestedAt])
  @@map("account_exports")
}

model ActivityEvent {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  type       ActivityType
  summary    String
  metadata   Json?
  occurredAt DateTime     @map("occurred_at")
  createdAt  DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt(sort: Desc)])
  @@map("activity_events")
}

model Post {
  id           String         @id @default(uuid()) @db.Uuid
  authorUserId String?        @map("author_user_id") @db.Uuid
  isAnonymous  Boolean        @default(false) @map("is_anonymous")
  circleId     String?        @map("circle_id") @db.Uuid
  body         String
  visibility   PostVisibility @default(MEMBERS)
  status       ContentStatus  @default(ACTIVE)
  version      Int            @default(1)
  editedAt     DateTime?      @map("edited_at")
  deletedAt    DateTime?      @map("deleted_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  author          User?                @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  anonymousAuthor PostAnonymousAuthor?
  circle          Circle?              @relation(fields: [circleId], references: [id], onDelete: Restrict)
  media           PostMedia[]
  linkPreview     PostLinkPreview?
  comments        Comment[]
  reactions       PostReaction[]
  notifications   Notification[]
  aiModFlags      AiModFlag[]

  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([authorUserId, createdAt(sort: Desc)])
  @@map("posts")
}

model PostAnonymousAuthor {
  postId       String   @id @map("post_id") @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  displayLabel String   @map("display_label")
  createdAt    DateTime @default(now()) @map("created_at")

  post Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("post_anonymous_authors")
}

model PostMedia {
  postId   String @map("post_id") @db.Uuid
  mediaId  String @map("media_id") @db.Uuid
  position Int
  altText  String? @map("alt_text")

  post  Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  media MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@id([postId, mediaId])
  @@unique([postId, position])
  @@map("post_media")
}

model PostLinkPreview {
  postId       String   @id @map("post_id") @db.Uuid
  sourceUrl    String   @map("source_url")
  canonicalUrl String   @map("canonical_url")
  title        String?
  description  String?
  siteName     String?  @map("site_name")
  fetchStatus  String   @map("fetch_status")
  fetchedAt    DateTime @map("fetched_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("post_link_previews")
}

model Comment {
  id              String        @id @default(uuid()) @db.Uuid
  postId          String        @map("post_id") @db.Uuid
  authorUserId    String?       @map("author_user_id") @db.Uuid
  parentCommentId String?       @map("parent_comment_id") @db.Uuid
  isAnonymous     Boolean       @default(false) @map("is_anonymous")
  body            String
  status          ContentStatus @default(ACTIVE)
  version         Int           @default(1)
  editedAt        DateTime?     @map("edited_at")
  deletedAt       DateTime?     @map("deleted_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  post             Post                     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author           User?                    @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  anonymousAuthor  CommentAnonymousAuthor?
  parent           Comment?                 @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies          Comment[]                @relation("CommentReplies")
  reactions        CommentReaction[]
  notifications    Notification[]
  aiModFlags       AiModFlag[]

  @@index([postId, createdAt, id])
  @@index([authorUserId, createdAt])
  @@map("comments")
}

model CommentAnonymousAuthor {
  commentId    String   @id @map("comment_id") @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  displayLabel String   @map("display_label")
  createdAt    DateTime @default(now()) @map("created_at")

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("comment_anonymous_authors")
}

model AnonymousUsageDaily {
  userId            String   @map("user_id") @db.Uuid
  usageDate         DateTime @map("usage_date") @db.Date
  contributionCount Int      @default(0) @map("contribution_count")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, usageDate])
  @@map("anonymous_usage_daily")
}

model AuditLog {
  id                 String   @id @default(uuid()) @db.Uuid
  occurredAt         DateTime @default(now()) @map("occurred_at")
  actorUserId        String?  @map("actor_user_id") @db.Uuid
  impersonatedUserId String?  @map("impersonated_user_id") @db.Uuid
  actorReference     String?  @map("actor_reference") @db.Uuid
  actorType          String   @map("actor_type")
  action             String
  targetType         String   @map("target_type")
  targetId           String?  @map("target_id") @db.Uuid
  result             String
  requestId          String?  @map("request_id")
  traceId            String?  @map("trace_id")
  metadata           Json     @default("{}")

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([occurredAt(sort: Desc)])
  @@index([actorUserId, occurredAt(sort: Desc)])
  @@index([targetType, targetId, occurredAt(sort: Desc)])
  @@map("audit_logs")
}

model PostReaction {
  postId    String       @map("post_id") @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  kind      ReactionKind
  createdAt DateTime     @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId, createdAt])
  @@map("post_reactions")
}

model CommentReaction {
  commentId String       @map("comment_id") @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  kind      ReactionKind
  createdAt DateTime     @default(now()) @map("created_at")

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@index([userId, createdAt])
  @@map("comment_reactions")
}

model SessionFamily {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  userAgentSummary  String?   @map("user_agent_summary")
  absoluteExpiresAt DateTime  @map("absolute_expires_at")
  lastUsedAt        DateTime  @map("last_used_at")
  revokedAt         DateTime? @map("revoked_at")
  revocationReason  String?   @map("revocation_reason")
  createdAt         DateTime  @default(now()) @map("created_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@index([userId, revokedAt])
  @@map("session_families")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  familyId         String    @map("family_id") @db.Uuid
  generation       Int
  refreshTokenHash Bytes     @map("refresh_token_hash")
  issuedAt         DateTime  @map("issued_at")
  expiresAt        DateTime  @map("expires_at")
  rotatedAt        DateTime? @map("rotated_at")
  revokedAt        DateTime? @map("revoked_at")
  replacedById     String?   @map("replaced_by_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")

  family SessionFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([familyId, generation])
  @@index([familyId, revokedAt])
  @@map("sessions")
}

model Circle {
  id              String           @id @default(uuid()) @db.Uuid
  slug            String           @unique
  name            String
  description     String
  guidelines      String
  visibility      CircleVisibility
  joinPolicy      CircleJoinPolicy @map("join_policy")
  createdByUserId String?          @map("created_by_user_id") @db.Uuid
  avatarMediaId   String?          @map("avatar_media_id") @db.Uuid
  status          CircleStatus     @default(ACTIVE)
  adminFeatured   Boolean          @default(false) @map("admin_featured")
  memberCount     Int              @default(0) @map("member_count")
  version         Int              @default(1)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  createdBy User?          @relation("CircleCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  avatar    MediaAsset?    @relation("CircleAvatar", fields: [avatarMediaId], references: [id], onDelete: SetNull)
  members   CircleMember[]
  invites   CircleInvite[]
  mutes     CircleMute[]
  posts     Post[]
  notifications Notification[]

  @@index([status, createdAt(sort: Desc)])
  @@map("circles")
}

model CircleMute {
  circleId      String    @map("circle_id") @db.Uuid
  mutedUserId   String    @map("muted_user_id") @db.Uuid
  mutedByUserId String?   @map("muted_by_user_id") @db.Uuid
  reason        String?
  expiresAt     DateTime? @map("expires_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  circle  Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  muted   User   @relation("CircleMutedUser", fields: [mutedUserId], references: [id], onDelete: Cascade)
  mutedBy User?  @relation("CircleMutedBy", fields: [mutedByUserId], references: [id], onDelete: SetNull)

  @@id([circleId, mutedUserId])
  @@map("circle_mutes")
}

model CircleMember {
  circleId        String           @map("circle_id") @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  role            CircleRole       @default(MEMBER)
  status          MembershipStatus @default(ACTIVE)
  requestedAt     DateTime?        @map("requested_at")
  joinedAt        DateTime?        @map("joined_at")
  decidedAt       DateTime?        @map("decided_at")
  leftAt          DateTime?        @map("left_at")
  invitedByUserId String?          @map("invited_by_user_id") @db.Uuid
  decidedByUserId String?          @map("decided_by_user_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

