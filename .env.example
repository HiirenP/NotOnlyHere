# Copy to .env and adjust for local development
DATABASE_URL=postgresql://notonlyhere:notonlyhere@localhost:5432/notonlyhere
REDIS_URL=redis://localhost:6379
API_PORT=3001
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
# Optional: comma-separated hostnames for Next.js dev when using a cloud port proxy
# ALLOWED_DEV_ORIGINS=p-3000-pod-example.agent.cvm.dev
NODE_ENV=development
LOG_LEVEL=info
# Phase 0 dev auth — disabled in production
PHASE0_DEV_AUTH=true
COOKIE_SECRET=change-me-in-production-use-32-chars-min
SESSION_ACCESS_TTL_MINUTES=15
SESSION_REFRESH_TTL_DAYS=30
# OAuth (optional — configure for Google/Apple sign-in)
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_APPLE_CLIENT_ID=
